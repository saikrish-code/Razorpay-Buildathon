# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=recoup
APP_VERSION=0.1.0
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default): sqlite+aiosqlite:///./recoup.db
# Postgres example: postgresql+asyncpg://user:password@localhost/recoup
DATABASE_URL=sqlite+aiosqlite:///./recoup.db

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
